# OpsPulse – .gitignore
# Covers common OS artefacts, editor metadata, and tool directories.
# This project has no build step, so there are no dist/ or node_modules/ entries.

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
Session.vim
.netrwhist

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# Node / npm (if tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Browser testing tools
.browserstack/
cypress/videos/
cypress/screenshots/

# screenshot.png is NOT ignored — commit it when captured

# Environment / secrets (future-proofing)
.env
.env.*
!.env.example